{
	"name": "@byeolnaerim/flex-layout",
	"version": "0.0.14",
	"type": "module",
	"license": "Apache-2.0",
	"author": "Joohyoung Kim (@oozu1994)",
	"description": "A React UI layout component for building resizable split views. Wrap panes with FlexLayout and drag the divider to resize horizontally or vertically.",
	"keywords": [
		"react",
		"ui",
		"layout",
		"flex",
		"split",
		"split-pane",
		"splitter",
		"resizable",
		"resize",
		"drag",
		"divider",
		"panel",
		"panes",
		"dock",
		"flex-layout",
		"flexLayout",
		"vscode",
		"rxjs",
		"typescript"
	],
	"homepage": "https://byeolnaerim.com/flex-layout",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joohyoungkim19940805/flex-layout.git"
	},
	"bugs": {
		"url": "https://github.com/joohyoungkim19940805/flex-layout/issues"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"README.en.md",
		"README.ko.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./providers": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./utils": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		},
		"./store": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json && npm run copy:assets",
		"copy:assets": "cpy \"src/**/*.css\" \"dist\"",
		"dev": "tsup --watch",
		"prepack": "npm run build",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"react": ">=18 <20",
		"react-dom": ">=18 <20"
	},
	"dependencies": {
		"@byeolnaerim/global-rx-state": ">=0.0.1 <0.1.0",
		"fast-deep-equal": "^3.1.3",
		"rxjs": ">=7"
	},
	"devDependencies": {
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@byeolnaerim/global-rx-state": "0.0.3",
		"esbuild-plugin-preserve-directives": "^0.0.11",
		"cpy-cli": "^5",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"rxjs": "^7.8.2",
		"tsup": "^8.5.1",
		"typescript": "6.0.3"
	},
	"overrides": {
		"esbuild": "0.28.0"
	}
}
